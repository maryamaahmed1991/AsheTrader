<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.5.0.0</Version>
    <Name>Ashe's Trader</Name>
    <Author>Ashe</Author>
    <Punchline>Coordinate character and retainer item transfers across two PCs.</Punchline>
    <Description>LAN-coordinated item transfers, connected-account inventory search, and independent FC fuel queues with workshop or Resident Caretaker suppliers and automatic retainer deposits.</Description>
    <Tags>trade;inventory;characters;fuel</Tags>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AsheTrader.Core/AsheTrader.Core.csproj" />
    <Content Include="../../LICENSE.md" Link="LICENSE.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
